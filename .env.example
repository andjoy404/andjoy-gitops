# ============================================
# AndJoy GitOps — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.
#
# DEFAULT INSTALLATION (bundled PostgreSQL):
#   docker compose up -d
#   (uses bundled PostgreSQL, connects as DB_HOST=postgres)
#
# EXTERNAL POSTGRESQL:
#   1. Set DB_HOST=<external-host>
#   2. Disable bundled service: docker compose up -d --scale postgres=0

# ------------------------------------------
# DATABASE
# ------------------------------------------
# Connect to bundled postgres service
DB_HOST=postgres
DB_PORT=5432
DB_NAME=andjog_gitops
DB_USER=andjog_gitops_user
DB_PASSWORD=CHANGE_ME

# Connection pool size (10-20 for typical deployments, 50+ for high load)
DATABASE_MAX_CONNECTIONS=10

# ------------------------------------------
# APPLICATION
# ------------------------------------------
APP_PORT=8090
# Spring profile: "production" for prod, empty string for local development
SPRING_PROFILES_ACTIVE=production

# ------------------------------------------
# SECURITY
# ------------------------------------------
# 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
# Used for AES-256-GCM encryption of GitLab tokens
ENVIRONMENT_TOKEN_ENCRYPTION_KEY=CHANGE_ME

# ------------------------------------------
# SESSION COOKIES
# ------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
# Controls the secure flag on session cookies.
# For local HTTP (http://localhost:8090):
#   SESSION_SECURE=false
# For production behind HTTPS/TLS termination:
#   SESSION_SECURE=true
# If SESSION_SECURE is not set, it follows spring.profiles.active=="production"
SESSION_SECURE=false

# ------------------------------------------
# APPLICATION BEHAVIOR
# ------------------------------------------
# Read-only mode disables write actions in the API
READ_ONLY=false
HIDE_WRITE_ACTIONS=false

# ------------------------------------------
# ANALYTICS/SYNC
# ------------------------------------------
ANALYTICS_SYNC_INTERVAL_SECONDS=60
ANALYTICS_RETENTION_DAYS=30
PIPELINE_HISTORY_DAYS=90

# ------------------------------------------
# UI
# ------------------------------------------
DEFAULT_PAGE_SIZE=10
PAGE_SIZE_OPTIONS=10,20,30,40,50

# ------------------------------------------
# GITLAB API CLIENT
# ------------------------------------------
# IMPORTANT: GitLab base URLs are stored per-environment in the database
# (column: gitlab_environments.base_url). There is NO global GitLab base URL.
# The application uses each environment's configured URL for every API call.

GITLAB_API_TIMEOUT_SECONDS=30
GITLAB_MAX_CONCURRENT_REQUESTS=8
GITLAB_MAX_RETRIES=3

# ------------------------------------------
# OBSERVABILITY
# ------------------------------------------
# Logging controlled via Spring configuration and docker-compose logging driver
